# Copy to .env and fill in. Nothing here is committed.

# --- LLM provider (swappable) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # a small fast Claude model, e.g. claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=              # a small fast OpenAI model, e.g. gpt-4o-mini

# --- Email / OTP  ---
EMAIL_SMTP_SERVER =
EMAIL_APP_PASSWORD =
EMAIL_ADDRESS =
DEMO_USER_EMAIL =           # where OTP + result emails go in the demo (defaults to EMAIL_ADDRESS)

# --- Optional overrides (defaults live in config.py) ---
# HIGH_VALUE_THRESHOLD=50000
# LOW_MAX=30
# GREY_MAX=70
# VELOCITY_WINDOW_MIN=60
# VELOCITY_MAX_TXNS=5
# OTP_TTL_SEC=300
# OTP_LENGTH=6


# --- LangSmith Settings ---

LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=